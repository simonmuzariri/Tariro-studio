#include <Servo.h>

uint8_t colourS2 = 10;
uint8_t colourS3 = 11;
uint8_t colourOut = 12;
Servo servo_3;
double servo_3_angle = 90;
double red = 0;
double green = 0;
double blue = 0;

// TCS3200: select a colour filter and measure the output pulse; shorter pulse = stronger colour.
long tariroColour(uint8_t s2Level, uint8_t s3Level) {
  digitalWrite(colourS2, s2Level);
  digitalWrite(colourS3, s3Level);
  delay(5);
  unsigned long width = pulseIn(colourOut, LOW, 50000UL);
  return width == 0 ? 0 : 100000L / (long)width;
}

void setup() {
  Serial.begin(9600);
  pinMode(8, OUTPUT);
  pinMode(9, OUTPUT);
  pinMode(10, OUTPUT);
  pinMode(11, OUTPUT);
  pinMode(12, INPUT);
  servo_3.attach(3);

  digitalWrite(8, HIGH);
  digitalWrite(9, LOW);
}

void loop() {
  red = tariroColour(LOW, LOW);
  green = tariroColour(HIGH, HIGH);
  blue = tariroColour(LOW, HIGH);
  Serial.println(String("R ") + String(red) + String(" G ") + String(green) + String(" B ") + String(blue));
  if (red > green && red > blue) {
    servo_3_angle = constrain(30, 0.0, 180.0);
    servo_3.write((int)servo_3_angle);
  } else {
    servo_3_angle = constrain(150, 0.0, 180.0);
    servo_3.write((int)servo_3_angle);
  }
  delay(300);
}
