#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

Adafruit_SSD1306 oled(128, 64, &Wire, -1);
double dryness = 0;

void setup() {
  digitalWrite(5, HIGH);
  pinMode(5, OUTPUT);
  pinMode(7, INPUT);
  oled.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  oled.clearDisplay();
  oled.setTextColor(SSD1306_WHITE);
  oled.display();
}

void loop() {
  dryness = map(analogRead(A0), 0, 1023, 0, 100);
  if (dryness > 60) {
    digitalWrite(5, LOW);
  } else {
    digitalWrite(5, HIGH);
  }
  if (digitalRead(7) == HIGH) {
    tone(6, 2000, 150);
  }
  oled.clearDisplay();
  oled.setTextSize(2);
  oled.setCursor(0, 0);
  oled.print("Garden");
  oled.display();
  oled.setTextSize(1);
  oled.setCursor(0, 28);
  oled.print(String("Dryness: ") + String(dryness) + String(" %"));
  oled.display();
  delay(1000);
}
