#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);
DHT dht11_2(2, DHT11);

void setup() {
  dht11_2.begin();
  lcd.init();
  lcd.backlight();
}

void loop() {
  lcd.clear();
  lcd.setCursor(constrain((int)(1) - 1, 0, 15), 0);
  lcd.print(String("Temp: ") + String(dht11_2.readTemperature()) + String(" C"));
  lcd.setCursor(constrain((int)(1) - 1, 0, 15), 1);
  lcd.print(String("Humidity: ") + String(dht11_2.readHumidity()) + String(" %"));
  delay(2000);
}
