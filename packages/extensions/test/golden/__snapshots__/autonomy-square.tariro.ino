const uint8_t TARIRO_INA = 4;
const uint8_t TARIRO_ENA = 5;
const uint8_t TARIRO_INB = 7;
const uint8_t TARIRO_ENB = 6;
// Rotary encoders. Counts change inside interrupts, so they are volatile.
#if defined(ESP32)
#define TARIRO_ISR IRAM_ATTR
#else
#define TARIRO_ISR
#endif
struct TariroEncoder {
  uint8_t pinA;
  uint8_t pinB;
  bool quadrature;
  volatile long count;
  double countsPerTurn;
  double wheelDiameterMm;
  long lastCount;
  unsigned long lastMicros;
  double turnsPerSecond;
};
// 0 = left wheel, 1 = right wheel, 2 = encoder 1, 3 = encoder 2. Defaults: 20 pulses per turn, 65 mm wheel.
TariroEncoder tariroEncoders[4] = {
  {0, 0, false, 0, 20.0, 65.0, 0, 0, 0.0},
  {0, 0, false, 0, 20.0, 65.0, 0, 0, 0.0},
  {0, 0, false, 0, 20.0, 65.0, 0, 0, 0.0},
  {0, 0, false, 0, 20.0, 65.0, 0, 0, 0.0},
};

// Drive one channel of the TB6612FNG. motor: 'A' or 'B'; forward: direction; speedPercent: 0–100.
void tariroMotor(char motor, bool forward, double speedPercent) {
  int duty = constrain((int)(speedPercent * 255.0 / 100.0), 0, 255);
  uint8_t dir = motor == 'A' ? TARIRO_INA : TARIRO_INB;
  uint8_t pwm = motor == 'A' ? TARIRO_ENA : TARIRO_ENB;
  digitalWrite(dir, forward ? HIGH : LOW);
  analogWrite(pwm, duty);
}

void tariroMotorStop(char motor) {
  analogWrite(motor == 'A' ? TARIRO_ENA : TARIRO_ENB, 0);
}

// One pulse edge on channel A. With two channels, B tells which way the shaft turned.
void TARIRO_ISR tariroEncoderTick(uint8_t i) {
  TariroEncoder &e = tariroEncoders[i];
  if (e.quadrature && digitalRead(e.pinA) == digitalRead(e.pinB)) e.count--;
  else e.count++;
}
void TARIRO_ISR tariroEncoderIsr0() { tariroEncoderTick(0); }
void TARIRO_ISR tariroEncoderIsr1() { tariroEncoderTick(1); }
void TARIRO_ISR tariroEncoderIsr2() { tariroEncoderTick(2); }
void TARIRO_ISR tariroEncoderIsr3() { tariroEncoderTick(3); }

// Quadrature counts both edges of A (2 counts per pulse); single channel counts rising edges.
void tariroEncoderBegin(uint8_t i, uint8_t pinA, uint8_t pinB, bool quadrature) {
  TariroEncoder &e = tariroEncoders[i];
  // Keep the resolution if "set encoder" ran first: only the counts-per-pulse factor changes.
  e.countsPerTurn = e.countsPerTurn / (e.quadrature ? 2.0 : 1.0) * (quadrature ? 2.0 : 1.0);
  e.pinA = pinA;
  e.pinB = pinB;
  e.quadrature = quadrature;
  pinMode(pinA, INPUT_PULLUP);
  if (quadrature) pinMode(pinB, INPUT_PULLUP);
  void (*isr)() = i == 0 ? tariroEncoderIsr0 : i == 1 ? tariroEncoderIsr1 : i == 2 ? tariroEncoderIsr2 : tariroEncoderIsr3;
  attachInterrupt(digitalPinToInterrupt(pinA), isr, quadrature ? CHANGE : RISING);
  e.lastMicros = micros();
}

void tariroEncoderResolution(uint8_t i, double pulsesPerTurn, double gearRatio, double wheelDiameterMm) {
  TariroEncoder &e = tariroEncoders[i];
  if (pulsesPerTurn > 0 && gearRatio > 0) e.countsPerTurn = pulsesPerTurn * gearRatio * (e.quadrature ? 2.0 : 1.0);
  if (wheelDiameterMm > 0) e.wheelDiameterMm = wheelDiameterMm;
}

long tariroEncoderCount(uint8_t i) {
  noInterrupts();
  long c = tariroEncoders[i].count;
  interrupts();
  return c;
}

void tariroEncoderReset(uint8_t i) {
  noInterrupts();
  tariroEncoders[i].count = 0;
  interrupts();
  tariroEncoders[i].lastCount = 0;
  tariroEncoders[i].turnsPerSecond = 0;
  tariroEncoders[i].lastMicros = micros();
}

double tariroEncoderTurns(uint8_t i) { return tariroEncoderCount(i) / tariroEncoders[i].countsPerTurn; }

// Speed from the counts since the last measurement (at least 50 ms earlier).
double tariroEncoderTurnsPerSecond(uint8_t i) {
  TariroEncoder &e = tariroEncoders[i];
  unsigned long now = micros();
  unsigned long elapsed = now - e.lastMicros;
  if (elapsed >= 50000UL) {
    long c = tariroEncoderCount(i);
    e.turnsPerSecond = ((c - e.lastCount) / e.countsPerTurn) * 1000000.0 / elapsed;
    e.lastCount = c;
    e.lastMicros = now;
  }
  return e.turnsPerSecond;
}

// Wheel circumference in cm.
double tariroEncoderCircumference(uint8_t i) { return tariroEncoders[i].wheelDiameterMm * 3.14159265 / 10.0; }

// HC-SR04: 10 µs trigger pulse, echo time → distance (sound travels ~0.0343 cm/µs, there and back).
double tariroDistanceCm(uint8_t trig, uint8_t echo) {
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);
  unsigned long us = pulseIn(echo, HIGH, 30000UL);
  return us * 0.0343 / 2.0;
}

// Wheel distance in cm from an encoder (whichever way it turned).
double tariroWheelCm(uint8_t i) { return fabs(tariroEncoderTurns(i) * tariroEncoderCircumference(i)); }

// Drive straight: when one wheel gets ahead, slow it and speed up the other (P control).
void tariroDriveCm(double cm, double speed) {
  tariroEncoderReset(0);
  tariroEncoderReset(1);
  unsigned long start = millis();
  while ((tariroWheelCm(0) + tariroWheelCm(1)) / 2.0 < cm && millis() - start < 15000UL) {
    double error = tariroWheelCm(0) - tariroWheelCm(1);
    tariroMotor('A', true, constrain(speed - error * 8.0, 0.0, 100.0));
    tariroMotor('B', true, constrain(speed + error * 8.0, 0.0, 100.0));
    delay(10);
  }
  tariroMotorStop('A');
  tariroMotorStop('B');
}

// Spin on the spot: each wheel travels an arc of the circle the wheels make.
void tariroTurnDeg(bool left, double degrees, double speed, double trackCm) {
  double arc = 3.14159265 * trackCm * fabs(degrees) / 360.0;
  tariroEncoderReset(0);
  tariroEncoderReset(1);
  unsigned long start = millis();
  tariroMotor('A', !left, speed);
  tariroMotor('B', left, speed);
  while ((tariroWheelCm(0) + tariroWheelCm(1)) / 2.0 < arc && millis() - start < 10000UL) delay(5);
  tariroMotorStop('A');
  tariroMotorStop('B');
}

void setup() {
  pinMode(2, INPUT_PULLUP);
  pinMode(3, INPUT_PULLUP);
  pinMode(TARIRO_INA, OUTPUT);
  pinMode(TARIRO_ENA, OUTPUT);
  pinMode(TARIRO_INB, OUTPUT);
  pinMode(TARIRO_ENB, OUTPUT);
  pinMode(12, OUTPUT);
  pinMode(13, INPUT);

  tariroEncoderBegin(0, 2, 2, false);
  tariroEncoderBegin(1, 3, 3, false);
  for (int i = 0; i < 4; i++) {
    tariroDriveCm(40, 50);
    tariroTurnDeg(false, 90, 40, 13);
  }
  while (true) {
    double d = tariroDistanceCm(12, 13);
    if (d > 0 && d < 15) break;
    tariroMotor('A', true, 45);
    tariroMotor('B', true, 45);
    delay(30);
  }
  tariroMotorStop('A');
  tariroMotorStop('B');
}

