double count = 0;
double lightLevel = 0;
String message = "";
double brightness(double reading);
void beep(double times);

double brightness(double reading) {
  return constrain(255 - (double)reading / 4, 0, 255);
}

void beep(double times) {
  for (int i = 0; i < times; i++) {
    tone(8, 880, 100);
    delay(200);
  }
}

void setup() {
  Serial.begin(9600);
  pinMode(3, OUTPUT);
  pinMode(13, OUTPUT);

  count = 0;
  Serial.println("Night light ready");
  beep(2);
}

void loop() {
  lightLevel = analogRead(A0);
  analogWrite(3, brightness(lightLevel));
  if (lightLevel < 300) {
    digitalWrite(13, HIGH);
  } else {
    digitalWrite(13, LOW);
  }
  count += 1;
  if (fmod(count, 10) == 0) {
    message = String("light level: ") + String(lightLevel);
    Serial.println(message);
  }
  while (Serial.available() > 0) {
    Serial.println(Serial.readStringUntil('\n'));
  }
  delay(100);
}
